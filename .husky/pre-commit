# Fail fast on any error
set -euo pipefail

echo "🧹 Running lint-staged (ESLint + Prettier on staged files)…"
npx lint-staged

# If the Prisma schema is staged, keep it tidy, valid, and regen types
if git diff --name-only --cached | grep -q '^prisma/schema\.prisma$'; then
  echo "🧭 Prisma schema changed — formatting, validating, and generating client…"
  npx prisma format
  npx prisma validate
  npx prisma generate
fi

# Type-check the project (fast, no emit)
if [ -f "tsconfig.json" ]; then
  echo "🔎 Type-checking with TypeScript…"
  npx tsc --noEmit
fi

# Optional: Next.js lint (if you want Next-specific rules beyond eslint --fix via lint-staged)
